# App
APP_ENV=development
APP_URL=http://localhost:3000
PORTAL_NAME="Portal Viçosa"
PORTAL_SUBTITLE="Educação, Transporte e Esporte"
MUNICIPALITY_NAME="Viçosa"
MUNICIPALITY_STATE="MG"
MUNICIPALITY_IBGE_CODE="3171303"

# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth
AUTH_SECRET="change-me-with-at-least-32-random-characters"
SESSION_MAX_AGE_HOURS=12

# Address / maps
CEP_PROVIDER=viacep
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Storage
STORAGE_PROVIDER=none
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# E-mail
EMAIL_PROVIDER=none
EMAIL_FROM="Portal Viçosa <no-reply@example.org>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Security
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
SMTP_SECURE=false

# Optional demo/test users (set only in protected deployment variables)
SEED_SCHOOL_EMAIL=
SEED_SCHOOL_PASSWORD=
SEED_SECRETARIA_EMAIL=
SEED_SECRETARIA_PASSWORD=
