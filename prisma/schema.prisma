generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}
enum AddressType {
  URBAN
  RURAL
}
enum LocationSource {
  CEP
  GEOCODE
  USER_PIN
  ADMIN
  IMPORT
}
enum LocationPrecision {
  EXACT
  APPROXIMATE
  NEIGHBORHOOD
  RURAL_LOCALITY
}
enum NeighborhoodType {
  URBAN
  RURAL
  DISTRICT
  COMMUNITY
  OTHER
}
enum SchoolTransportPeriodStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
}
enum SchoolTransportRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING
  APPROVED
  DENIED
  ROUTE_DEFINED
  ACTIVE
  CANCELED
}
enum ExtraRequestStatus {
  REQUESTED
  UNDER_REVIEW
  PENDING
  APPROVED
  VEHICLE_DEFINED
  DRIVER_DEFINED
  DRIVER_CONFIRMED
  COMPLETED
  DENIED
  CANCELED
}
enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  UNAVAILABLE
}
enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum TripStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}
enum SportsActivityStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CANCELED
  COMPLETED
}
enum SportsRegistrationStatus {
  CONFIRMED
  CANCELED
  COMPLETED
}
enum WaitListStatus {
  WAITING
  CALLED
  CONFIRMED
  EXPIRED
  CANCELED
}
enum NotificationChannel {
  INTERNAL
  EMAIL
  WHATSAPP
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}
enum DocumentOwnerType {
  SCHOOL_TRANSPORT_REQUEST
  EXTRA_REQUEST
  SPORTS_REGISTRATION
  USER
  OTHER
}
enum EntityType {
  NEIGHBORHOOD
  RURAL_LOCALITY
  STREET
  DISTRICT
}
enum ExtraActivityType {
  PEDAGOGICAL_VISIT
  SPORTS_COMPETITION
  EVENT
  FAIR
  CULTURAL_ACTIVITY
  TECHNICAL_VISIT
  TOUR
  OTHER
}
enum ExtraShift {
  MORNING
  AFTERNOON
}
enum VehicleType {
  BUS
  MINIBUS
  VAN
  OTHER
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  ASSIGN
  IMPORT
  MERGE
  VIEW_DOCUMENT
}
model Municipality {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  state        String   @db.VarChar(2)
  ibgeCode     String?  @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  districts       District[]
  neighborhoods   Neighborhood[]
  ruralLocalities RuralLocality[]
  streets         Street[]
  addresses       Address[]
  schools         School[]

  @@unique([name, state])
  @@map("municipalities")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  public    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Person {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String
  cpf         String?   @unique
  birthDate   DateTime?
  phone       String?
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?
  student     Student?
  guardian    Guardian?
  driver      Driver?
  addresses   Address[]
  sportParticipations SportsRegistration[] @relation("SportsParticipant")
  sportWaitEntries SportsWaitingList[] @relation("SportsWaitParticipant")

  @@index([fullName])
  @@map("persons")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  personId     String     @unique @db.Uuid
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  person             Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  roles              UserRole[]
  schoolMemberships  SchoolUser[]
  notifications      Notification[]
  auditLogs          AuditLog[]            @relation("AuditActor")
  sportRegistrations SportsRegistration[]
  sportWaitEntries   SportsWaitingList[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Student {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @unique @db.Uuid
  schoolId  String?  @db.Uuid
  grade     String?
  shift     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person            Person                   @relation(fields: [personId], references: [id], onDelete: Cascade)
  school            School?                  @relation(fields: [schoolId], references: [id])
  guardians         StudentGuardian[]
  transportRequests SchoolTransportRequest[]

  @@map("students")
}

model Guardian {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person   Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  students StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  studentId  String @db.Uuid
  guardianId String @db.Uuid
  relation   String?
  primary    Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model District {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId String   @db.Uuid
  name           String
  normalizedName String
  active         Boolean  @default(true)
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality    Municipality    @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  ruralLocalities RuralLocality[]
  addresses       Address[]

  @@unique([municipalityId, normalizedName])
  @@index([normalizedName])
  @@map("districts")
}

model Neighborhood {
  id             String           @id @default(uuid()) @db.Uuid
  municipalityId String           @db.Uuid
  name           String
  normalizedName String
  type           NeighborhoodType @default(URBAN)
  officialCode   String?
  active         Boolean          @default(true)
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  municipality Municipality        @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  addresses    Address[]
  streetLinks  StreetNeighborhood[]
  schools      School[]

  @@unique([municipalityId, normalizedName, type])
  @@index([normalizedName])
  @@map("neighborhoods")
}

model RuralLocality {
  id                String             @id @default(uuid()) @db.Uuid
  municipalityId    String             @db.Uuid
  districtId        String?            @db.Uuid
  name              String
  normalizedName    String
  popularName       String?
  region            String?
  active            Boolean            @default(true)
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  locationPrecision LocationPrecision? 
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  district     District?    @relation(fields: [districtId], references: [id])
  addresses    Address[]

  @@unique([municipalityId, normalizedName])
  @@index([normalizedName])
  @@map("rural_localities")
}

model Street {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId String   @db.Uuid
  name           String
  normalizedName String
  cep            String?
  type           String?
  active         Boolean  @default(true)
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality Municipality         @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  neighborhoods StreetNeighborhood[]
  addresses     Address[]
  schools       School[]

  @@unique([municipalityId, normalizedName])
  @@index([normalizedName])
  @@map("streets")
}

model StreetNeighborhood {
  streetId       String @db.Uuid
  neighborhoodId String @db.Uuid

  street       Street       @relation(fields: [streetId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@id([streetId, neighborhoodId])
  @@map("street_neighborhoods")
}

model LocationAlias {
  id              String     @id @default(uuid()) @db.Uuid
  entityType      EntityType
  entityId        String     @db.Uuid
  alias           String
  normalizedAlias String
  createdAt       DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([normalizedAlias])
  @@unique([entityType, entityId, normalizedAlias])
  @@map("location_aliases")
}

model Address {
  id                String             @id @default(uuid()) @db.Uuid
  personId          String?            @db.Uuid
  municipalityId    String             @db.Uuid
  addressType       AddressType
  streetId          String?            @db.Uuid
  streetText        String?
  neighborhoodId    String?            @db.Uuid
  districtId        String?            @db.Uuid
  ruralLocalityId   String?            @db.Uuid
  cep               String?
  number            String?
  complement        String?
  ruralRoad         String?
  km                String?
  referencePoint    String?
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  locationSource    LocationSource?
  locationPrecision LocationPrecision?
  originalInput     String?
  verified          Boolean            @default(false)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  person            Person?               @relation(fields: [personId], references: [id], onDelete: Cascade)
  municipality      Municipality          @relation(fields: [municipalityId], references: [id])
  street            Street?               @relation(fields: [streetId], references: [id])
  neighborhood      Neighborhood?         @relation(fields: [neighborhoodId], references: [id])
  district          District?             @relation(fields: [districtId], references: [id])
  ruralLocality     RuralLocality?        @relation(fields: [ruralLocalityId], references: [id])
  transportRequests SchoolTransportRequest[]
  schools           School[]

  @@index([personId])
  @@index([neighborhoodId])
  @@index([ruralLocalityId])
  @@map("addresses")
}

model School {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId String   @db.Uuid
  name           String
  code           String?
  addressId      String?  @db.Uuid
  neighborhoodId String?  @db.Uuid
  streetId       String?  @db.Uuid
  phone          String?
  director       String?
  coordinator    String?
  openingHours   String?
  active         Boolean  @default(true)
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  address      Address?     @relation(fields: [addressId], references: [id])
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  street       Street?      @relation(fields: [streetId], references: [id])
  students     Student[]
  users        SchoolUser[]
  transportRequests SchoolTransportRequest[]
  extraRequests ExtracurricularRequest[]
  transportPeriods SchoolTransportPeriodSchool[]

  @@index([name])
  @@map("schools")
}

model SchoolUser {
  schoolId String @db.Uuid
  userId   String @db.Uuid
  active   Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([schoolId, userId])
  @@map("school_users")
}

model SchoolTransportPeriodSchool {
  periodId String @db.Uuid
  schoolId String @db.Uuid

  period SchoolTransportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([periodId, schoolId])
  @@index([schoolId])
  @@map("school_transport_period_schools")
}

model SchoolTransportPeriod {
  id                 String                      @id @default(uuid()) @db.Uuid
  name               String
  academicYear       Int
  requestStart       DateTime
  requestEnd         DateTime
  rules              String?
  status             SchoolTransportPeriodStatus @default(DRAFT)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  requests            SchoolTransportRequest[]
  schools             SchoolTransportPeriodSchool[]
  documentRequirements TransportDocumentRequirement[]

  @@index([academicYear, status])
  @@map("school_transport_periods")
}

model TransportDocumentRequirement {
  id        String   @id @default(uuid()) @db.Uuid
  periodId  String   @db.Uuid
  name      String
  required  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  period    SchoolTransportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("transport_document_requirements")
}

model SchoolTransportRequest {
  id                String                       @id @default(uuid()) @db.Uuid
  protocol          String                       @unique
  periodId          String                       @db.Uuid
  studentId         String                       @db.Uuid
  schoolId          String                       @db.Uuid
  addressId         String                       @db.Uuid
  grade             String?
  shift             String?
  entryTime         String?
  exitTime          String?
  accessibilityNeed Boolean                      @default(false)
  accessibilityInfo String?
  observations      String?
  status            SchoolTransportRequestStatus @default(DRAFT)
  submittedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  period   SchoolTransportPeriod @relation(fields: [periodId], references: [id])
  student  Student               @relation(fields: [studentId], references: [id])
  school   School                @relation(fields: [schoolId], references: [id])
  address  Address               @relation(fields: [addressId], references: [id])
  history  TransportRequestHistory[]
  documents Document[]

  @@unique([periodId, studentId])
  @@index([periodId, status])
  @@index([schoolId, status])
  @@map("school_transport_requests")
}

model TransportRequestHistory {
  id        String                       @id @default(uuid()) @db.Uuid
  requestId String                       @db.Uuid
  fromStatus SchoolTransportRequestStatus?
  toStatus   SchoolTransportRequestStatus
  note      String?
  changedBy String?                      @db.Uuid
  createdAt DateTime                     @default(now())

  request SchoolTransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("transport_request_history")
}

model ExtracurricularRequest {
  id                    String            @id @default(uuid()) @db.Uuid
  protocol              String            @unique
  schoolId              String            @db.Uuid
  responsibleName       String
  responsiblePhone      String
  activity              String
  purpose               ExtraActivityType
  purposeOther          String?
  shift                 ExtraShift?
  directorName          String?
  termsAcceptedAt       DateTime?
  departureAt           DateTime
  returnAt              DateTime
  origin                String
  destination           String
  destinationAddress    String?
  destinationLatitude   Decimal?          @db.Decimal(9, 6)
  destinationLongitude  Decimal?          @db.Decimal(9, 6)
  studentCount          Int
  companionCount        Int               @default(0)
  ageRange              String?
  accessibilityNeed     Boolean           @default(false)
  observations          String?
  status                ExtraRequestStatus @default(REQUESTED)
  createdById           String?           @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  trips  Trip[]
  documents Document[]
  history ExtraRequestHistory[]

  @@index([schoolId, departureAt])
  @@index([status])
  @@map("extracurricular_requests")
}

model ExtraRequestHistory {
  id         String             @id @default(uuid()) @db.Uuid
  requestId  String             @db.Uuid
  fromStatus ExtraRequestStatus?
  toStatus   ExtraRequestStatus
  note       String?
  changedBy  String?            @db.Uuid
  createdAt  DateTime           @default(now())

  request ExtracurricularRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("extra_request_history")
}

model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  identification String
  plate         String        @unique
  type          VehicleType
  capacity      Int
  accessible    Boolean       @default(false)
  status        VehicleStatus @default(AVAILABLE)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tripAssignments TripVehicleAssignment[]

  @@map("vehicles")
}

model Driver {
  id        String       @id @default(uuid()) @db.Uuid
  personId  String       @unique @db.Uuid
  cnh       String       @unique
  category  String
  cnhExpiry DateTime
  status    DriverStatus @default(ACTIVE)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  person          Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  tripAssignments TripDriverAssignment[]

  @@index([cnhExpiry])
  @@map("drivers")
}

model Trip {
  id                 String     @id @default(uuid()) @db.Uuid
  extraRequestId     String?    @db.Uuid
  sportsActivityId   String?    @db.Uuid
  title              String
  startAt            DateTime
  endAt              DateTime
  origin             String
  destination        String
  passengerCount     Int        @default(0)
  responsibleName    String?
  responsiblePhone   String?
  status             TripStatus @default(PLANNED)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  extraRequest   ExtracurricularRequest? @relation(fields: [extraRequestId], references: [id])
  sportsActivity SportsActivity?         @relation(fields: [sportsActivityId], references: [id])
  vehicles       TripVehicleAssignment[]
  drivers        TripDriverAssignment[]

  @@index([startAt, endAt])
  @@map("trips")
}

model TripVehicleAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @db.Uuid
  vehicleId  String   @db.Uuid
  active     Boolean  @default(true)
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, active])
  @@map("trip_vehicle_assignments")
}

model TripDriverAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @db.Uuid
  driverId   String   @db.Uuid
  active     Boolean  @default(true)
  confirmedAt DateTime?
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, active])
  @@map("trip_driver_assignments")
}

model SportsCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities SportsActivity[]

  @@map("sports_categories")
}

model SportsActivity {
  id                  String               @id @default(uuid()) @db.Uuid
  protocolPrefix      String               @default("ESP")
  categoryId          String               @db.Uuid
  name                String
  slug                String               @unique
  imageUrl            String?
  description         String
  audience            String?
  minAge              Int?
  maxAge              Int?
  classification      String?
  locationName        String
  addressText         String?
  latitude            Decimal?             @db.Decimal(9, 6)
  longitude           Decimal?             @db.Decimal(9, 6)
  capacity            Int
  registrationStart   DateTime
  registrationEnd     DateTime
  activityStart       DateTime
  activityEnd         DateTime?
  rulesUrl            String?
  responsibleName     String?
  contact             String?
  offersTransport     Boolean              @default(false)
  transportCapacity   Int?
  status              SportsActivityStatus @default(DRAFT)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  category      SportsCategory          @relation(fields: [categoryId], references: [id])
  schedules     SportsActivitySchedule[]
  registrations SportsRegistration[]
  waitingList   SportsWaitingList[]
  boardingPoints SportsBoardingPoint[]
  trips         Trip[]

  @@index([status, registrationStart, registrationEnd])
  @@map("sports_activities")
}

model SportsActivitySchedule {
  id         String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  weekday    Int
  startTime  String
  endTime    String?

  activity SportsActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("sports_activity_schedules")
}

model SportsBoardingPoint {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @db.Uuid
  name       String
  address    String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  capacity   Int?
  active     Boolean  @default(true)

  activity      SportsActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registrations SportsRegistration[]

  @@map("sports_boarding_points")
}

model SportsRegistration {
  id               String                   @id @default(uuid()) @db.Uuid
  protocol         String                   @unique
  activityId       String                   @db.Uuid
  userId           String                   @db.Uuid
  participantPersonId String                 @db.Uuid
  boardingPointId  String?                  @db.Uuid
  wantsTransport   Boolean                  @default(false)
  status           SportsRegistrationStatus @default(CONFIRMED)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  activity      SportsActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant   Person              @relation("SportsParticipant", fields: [participantPersonId], references: [id], onDelete: Cascade)
  boardingPoint SportsBoardingPoint? @relation(fields: [boardingPointId], references: [id])
  documents     Document[]

  @@unique([activityId, participantPersonId])
  @@index([userId, createdAt])
  @@index([activityId, status])
  @@map("sports_registrations")
}

model SportsWaitingList {
  id         String         @id @default(uuid()) @db.Uuid
  activityId String         @db.Uuid
  userId     String         @db.Uuid
  participantPersonId String @db.Uuid
  position   Int
  status     WaitListStatus @default(WAITING)
  calledAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  activity SportsActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant Person       @relation("SportsWaitParticipant", fields: [participantPersonId], references: [id], onDelete: Cascade)

  @@unique([activityId, participantPersonId])
  @@unique([activityId, position])
  @@index([activityId, status, position])
  @@map("sports_waiting_lists")
}

model Document {
  id               String            @id @default(uuid()) @db.Uuid
  ownerType        DocumentOwnerType
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String?
  createdById      String?           @db.Uuid
  transportRequestId   String?         @db.Uuid
  transportRequirementId String?       @db.Uuid
  extraRequestId       String?         @db.Uuid
  sportsRegistrationId String?       @db.Uuid
  createdAt        DateTime          @default(now())

  transportRequest SchoolTransportRequest? @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  transportRequirement TransportDocumentRequirement? @relation(fields: [transportRequirementId], references: [id], onDelete: SetNull)
  extracurricularRequest ExtracurricularRequest? @relation(fields: [extraRequestId], references: [id], onDelete: Cascade)
  sportsRegistration SportsRegistration? @relation(fields: [sportsRegistrationId], references: [id], onDelete: Cascade)

  @@unique([transportRequestId, transportRequirementId])
  @@index([ownerType, createdAt])
  @@map("documents")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  channel   NotificationChannel
  title     String
  message   String
  status    NotificationStatus @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  errorCode String?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  changedFields String[]
  before      Json?
  after       Json?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model ProtocolCounter {
  id        String   @id @default(uuid()) @db.Uuid
  namespace String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([namespace, year])
  @@map("protocol_counters")
}

model CepCache {
  cep          String   @id
  street       String?
  neighborhood String?
  city         String
  state        String
  provider     String
  raw          Json?
  updatedAt    DateTime @updatedAt

  @@map("cep_cache")
}

model GeocodingCache {
  id        String   @id @default(uuid()) @db.Uuid
  queryHash String   @unique
  query     String
  provider  String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  raw       Json?
  updatedAt DateTime @updatedAt

  @@map("geocoding_cache")
}
